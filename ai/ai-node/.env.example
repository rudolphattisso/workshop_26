# Copier en .env (non versionné). Le même jeton est configuré côté ml-detector (PC infra).
# Génération : python -c "import secrets; print(secrets.token_urlsafe(48))"
LLM_GATEWAY_TOKEN=a-remplacer-par-un-jeton-aleatoire-de-48-caracteres-au-moins

# IP du PC IA sur le réseau partagé avec le PC infra (127.0.0.1 = local uniquement).
GATEWAY_BIND=127.0.0.1

OLLAMA_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_S=120
# Consultation des rapports dans un navigateur : http://<PC IA>:8080/reports (utilisateur « soc »).
# Vide : pages désactivées. Lien utilisé par le tableau des incidents de Grafana.
REPORTS_PASSWORD=

# Contexte du modèle (tokens) : 4096 par défaut chez Ollama tronquait le prompt (~4 350 tokens).
LLM_NUM_CTX=8192
