# Copier en services/.env (non versionné) et remplacer les valeurs. Valeurs FACTICES.
PAYMENT_DB_PASSWORD=change-me
# URL utilisée par payment-api, Alembic et les tests (base locale de compose.dev.yml)
DATABASE_URL=postgresql+psycopg://payment_api:change-me@127.0.0.1:5433/payment

# Service d'auth : base locale (compose.dev.yml) et mots de passe des utilisateurs de démo (12 caractères minimum)
AUTH_DB_PASSWORD=change-me
AUTH_DATABASE_URL=postgresql+psycopg://auth_service:change-me@127.0.0.1:5434/auth
DEMO_CLIENT_PASSWORD=change-me
SMOKE_CLIENT_PASSWORD=change-me
OPERATOR_PASSWORD=change-me
# payment-api lancé en local vérifie les jetons de l'auth lancé en local sur le port 8001
AUTH_JWKS_URL=http://127.0.0.1:8001/auth/.well-known/jwks.json
