<!--
  Règles de détection propres au consortium (plage d'ID 100000+).
  Source : journaux récupérés par le log-forwarder (/var/log/agent/*.log) via l'agent.
    - BunkerWeb / ModSecurity : XSS, SQLi, flood, bannissement automatique
    - Services métier (JSON) : force brute, échec de remédiation (PRA)
-->
<group name="resilience,waf,">

  <!-- Une requête bloquée par ModSecurity (anomalie applicative) -->
  <rule id="100100" level="7">
    <match>ModSecurity: Access denied</match>
    <description>WAF BunkerWeb : requête malveillante bloquée (ModSecurity/OWASP CRS)</description>
    <group>attack,pci_dss_6.6,</group>
  </rule>

  <!-- XSS détectée spécifiquement -->
  <rule id="100101" level="10">
    <match>attack-xss</match>
    <description>WAF BunkerWeb : tentative d'injection XSS détectée et bloquée</description>
    <group>attack,xss,pci_dss_6.6,</group>
  </rule>

  <!-- SQLi détectée spécifiquement -->
  <rule id="100102" level="10">
    <match>attack-sqli</match>
    <description>WAF BunkerWeb : tentative d'injection SQL détectée et bloquée</description>
    <group>attack,sqli,pci_dss_6.6,</group>
  </rule>

  <!-- Campagne d'attaque : nombreuses requêtes bloquées en peu de temps -->
  <rule id="100103" level="12" frequency="8" timeframe="30">
    <if_matched_sid>100100</if_matched_sid>
    <description>WAF BunkerWeb : campagne d'attaque (nombreuses requêtes bloquées en 30 s)</description>
    <group>attack,</group>
  </rule>

  <!-- Bannissement automatique d'IP par BunkerWeb (réponse au bad-behavior / flood) -->
  <!-- Les lignes nginx-errorlog sont d'abord prises par les règles Nginx (31302...) :
       on s'y accroche en règle enfant, sinon notre règle n'est jamais évaluée. -->
  <rule id="100110" level="10">
    <if_sid>31301, 31302, 31303</if_sid>
    <match>is banned with reason bad behavior</match>
    <description>WAF BunkerWeb : IP bannie automatiquement (bad behavior / flood / DDoS)</description>
    <group>attack,ddos,</group>
  </rule>

  <!-- Compteur bad-behavior (une requête "mauvaise" de plus pour une IP) -->
  <rule id="100111" level="4">
    <if_sid>31300, 31301, 31302</if_sid>
    <match>BADBEHAVIOR] increased counter</match>
    <description>WAF BunkerWeb : requête anormale comptabilisée (bad behavior)</description>
    <group>attack,</group>
  </rule>

  <!-- Flood applicatif : beaucoup de requêtes anormales en peu de temps (DDoS probable) -->
  <rule id="100112" level="10" frequency="15" timeframe="20">
    <if_matched_sid>100111</if_matched_sid>
    <description>WAF BunkerWeb : volume de requêtes anormal (DDoS applicatif probable)</description>
    <group>attack,ddos,</group>
  </rule>

</group>

<group name="resilience,payment,json,">

  <!-- Échec de connexion applicatif (décodé depuis le JSON du service auth) -->
  <rule id="100200" level="5">
    <decoded_as>json</decoded_as>
    <field name="msg">login_failed</field>
    <description>Paiement : échec d'authentification (utilisateur $(username))</description>
    <group>authentication_failed,pci_dss_10.2.4,</group>
  </rule>

  <!-- Force brute : plusieurs échecs en peu de temps -->
  <rule id="100201" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <description>Paiement : force brute probable sur l'authentification</description>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <!-- Échec d'une remédiation automatique : intervention humaine requise (PRA) -->
  <rule id="100210" level="12">
    <decoded_as>json</decoded_as>
    <field name="msg">remediation_failed</field>
    <description>Remédiation automatique en échec : bascule PRA requise (cible $(target))</description>
    <group>service_availability,</group>
  </rule>

  <!-- Reprise automatique réussie (information) -->
  <rule id="100211" level="3">
    <decoded_as>json</decoded_as>
    <field name="msg">remediation_succeeded</field>
    <description>Remédiation automatique réussie (cible $(target))</description>
    <group>service_availability,</group>
  </rule>

</group>
