ption)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="710" width="180" height="100" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Moteur de remédiation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;webhook authentifié (Bearer)&lt;br&gt;liste blanche + cooldown&lt;br&gt;vérif. par transaction&lt;br&gt;:8000 ← 127.0.0.1:18090&lt;br&gt;monitoring, control, mgmt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="910" width="220" height="150" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;docker-proxy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;HAProxy durci&lt;br&gt;GET /containers&lt;br&gt;POST start/stop/restart SEULS&lt;br&gt;create/exec/kill → 403&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="910" width="220" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;docker-proxy-ro&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;GET containers,&lt;br&gt;networks, events&lt;br&gt;POST interdit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="910" width="190" height="150" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Docker Engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;/var/run/docker.sock&lt;br&gt;restart: unless-stopped&lt;br&gt;healthchecks · limites mém/CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y