oot)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="570" width="180" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;dashboards as code&lt;br&gt;:3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1160" y="570" width="190" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;blackbox-exporter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;sondes HTTP via WAF&lt;br&gt;:9115&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="710" width="180" height="100" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;waf-exporter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;stub_status nginx&lt;br&gt;:9113&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="180" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;postgres-exporter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;rôle exporter (pg_monitor)&lt;br&gt;:9187 · data, monitoring&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;arcSize=6;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="710" width="180" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;cAdvisor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#444'&gt;CPU / RAM conteneurs&lt;br&gt;:8080 · privilégié (exception)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;