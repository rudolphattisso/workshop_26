# Paramètres de déploiement — copier en .env (fait automatiquement par « ops deploy »).
# AUCUN secret ici : les secrets sont générés dans ./secrets/ (ignoré par Git).

COMPOSE_PROJECT_NAME=resilience
APP_VERSION=1.0.0

# --- Exposition réseau ----------------------------------------------------------
# Seul le WAF est publié sur le réseau du hotspot (PC Attaquant / jury).
# Mettre l'IP du hotspot Windows (ex. 192.168.137.1) pour ne publier QUE sur cette interface.
PUBLIC_BIND_ADDR=0.0.0.0
PUBLIC_HTTP_PORT=80

# Interfaces d'administration : jamais sur le réseau, uniquement en local sur le PC Hôte.
ADMIN_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
REMEDIATION_PORT=8090

# --- WAF : BunkerWeb (ModSecurity + OWASP CRS + bad-behavior) ----------------------
# Noms d'hôte acceptés par le WAF. AJOUTER l'IP du hotspot pour la démo, ex. :
#   PUBLIC_SERVER_NAME=192.168.137.1 localhost 127.0.0.1 bunkerweb
PUBLIC_SERVER_NAME=localhost 127.0.0.1 bunkerweb
WAF_RULE_ENGINE=On              # On (bloque) | DetectionOnly (journalise seulement) -> démo XSS avant/après
WAF_API_RATE=20r/s              # limitation de débit par IP (toutes URL)
WAF_LOGIN_RATE=5r/s             # limitation de débit sur /api/auth/login (anti brute force)
WAF_BADBEHAVIOR_THRESHOLD=20    # nb de réponses "mauvaises" (4xx/429) avant bannissement auto de l'IP (démo DDoS)
WAF_BAN_TIME=300                # durée du bannissement auto en secondes
# BW_API_TOKEN est généré automatiquement dans .env par « ops deploy » (ne pas versionner).

# --- Remédiation --------------------------------------------------------------------
REMEDIATION_COOLDOWN_SECONDS=45

# --- Grafana -----------------------------------------------------------------------
GRAFANA_ANONYMOUS_VIEWER=true   # consultation sans login (lecture seule) pour la démo

# --- SIEM : Wazuh ------------------------------------------------------------------
WAZUH_DASHBOARD_PORT=8443        # dashboard Wazuh sur https://127.0.0.1:8443 (loopback)
WAZUH_INDEXER_HEAP=1g            # tas JVM de l'indexer OpenSearch (1g conseillé ; 512m minimum)
# Mots de passe Wazuh : générés automatiquement dans .env par « ops deploy » (non versionnés).
# WAZUH_INDEXER_PASSWORD / WAZUH_API_PASSWORD / WAZUH_DASHBOARD_PASSWORD
